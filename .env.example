# Copy this file to .env. This template contains local-only placeholders, not secrets.

# Application ports and browser API URL
BACKEND_PORT=8080
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=Medora
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL + pgvector
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medora
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medora-docs

# A-stage feature switches
FEATURE_CONTEXT_BUILDER=true
FEATURE_LAYERED_RAG=true
FEATURE_TOOL_GATEWAY=true
FEATURE_A2UI_APPOINTMENT=true
FEATURE_MCP=false

# Embeddings. local-hash is deterministic and needs no network or API key.
AI_PROVIDER=local-hash
AI_API_KEY=replace-me
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_EMBEDDING_MODEL=local-hash-1024
AI_EMBEDDING_DIMENSIONS=1024

# Chat/rerank. Keep local for tests and infrastructure demos.
# For real chat/rerank set openai-compatible plus your real AI_CHAT_API_KEY.
AI_CHAT_PROVIDER=local
AI_CHAT_API_KEY=replace-me
AI_CHAT_BASE_URL=https://api.siliconflow.cn/v1
AI_CHAT_MODEL=replace-me

# Local authentication. Replace before any shared deployment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL=PT2H
JWT_REFRESH_TOKEN_TTL=P14D

# MCP demo. These values are disposable local placeholders, not production credentials.
MCP_SERVER_TOKEN=local-demo-medora-mcp-token-change-me
MCP_ALLOWED_ORIGINS=https://medora.internal
MCP_ALLOWED_REMOTE_HOSTS=localhost
MCP_CLIENT_ORIGIN=https://medora.internal
HOSPITAL_DIRECTORY_MCP_TOKEN=local-demo-hospital-token-change-me
HOSPITAL_DIRECTORY_MCP_PORT=18080

# Stable report metadata
MEDORA_FIXTURE_VERSION=m6-v1
MEDORA_ZONE_ID=Asia/Shanghai
