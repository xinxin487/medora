# Root project environment template

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=Medora

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medora
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medora-docs

# AI / LLM
# AI_PROVIDER=local-hash keeps local development runnable without network.
# Use openai-compatible to call real embedding/chat compatible endpoints.
AI_PROVIDER=local-hash
AI_API_KEY=replace-with-real-key
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
AI_EMBEDDING_DIMENSIONS=4096

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ACCESS_TOKEN_TTL=PT2H
JWT_REFRESH_TOKEN_TTL=P14D
